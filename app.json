{
  "expo": {
    "name": "LzApp",
    "slug": "LzApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "#55A9A0",
    "ios": {
      "supportsTablet": true
    },
    "android": {
